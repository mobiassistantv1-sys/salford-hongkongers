{
  "rules": {
    "ordering": {
      "public": {
        ".read": true,
        ".write": "auth != null && root.child('ordering/roles/' + auth.uid).exists()",
        "stock": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['pineapple', 'cocktail', 'sausage', 'eggtart'])",
          "$k": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && (root.child('ordering/roles/' + auth.uid).exists() || (data.exists() && newData.val() <= data.val()))"
          }
        }
      },
      "counter": {
        "$day": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && (root.child('ordering/roles/' + auth.uid).exists() || newData.val() === (data.exists() ? data.val() : 0) + 1)"
        }
      },
      "wcounter": {
        "$day": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && (root.child('ordering/roles/' + auth.uid).exists() || newData.val() === (data.exists() ? data.val() : 0) + 1)"
        }
      },
      "orders": {
        ".read": "auth != null && root.child('ordering/roles/' + auth.uid).exists()",
        "$day": {
          "$oid": {
            ".write": "auth != null && (root.child('ordering/roles/' + auth.uid).exists() || !data.exists())",
            ".validate": "root.child('ordering/roles/' + auth.uid).exists() || (newData.child('code').isString() && newData.child('k').isString() && root.child('ordering/qrTokens/' + newData.child('code').val()).val() === newData.child('k').val() && newData.child('status').val() === 'new' && newData.child('lines').exists() && !newData.child('paid').exists())"
          }
        }
      },
      "payments": {
        ".read": "auth != null && root.child('ordering/roles/' + auth.uid).val() === 'manager'",
        "$day": {
          "$pid": {
            ".write": "auth != null && root.child('ordering/roles/' + auth.uid).exists() && (!data.exists() || root.child('ordering/roles/' + auth.uid).val() === 'manager')"
          }
        }
      },
      "log": {
        ".read": "auth != null && root.child('ordering/roles/' + auth.uid).val() === 'manager'",
        "$day": {
          "$lid": {
            ".write": "auth != null && root.child('ordering/roles/' + auth.uid).exists() && !data.exists()"
          }
        }
      },
      "roles": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "qrTokens": {
        ".read": false,
        ".write": false
      }
    }
  }
}
